# คัดลอกเป็น .env แล้วใส่ค่าจริง (.env ห้าม commit)

# connection string จาก Supabase (Project Settings > Database) ต้องมี sslmode=require
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# สุ่มสตริงยาวอย่างน้อย 32 ตัวอักษร เช่น: openssl rand -base64 48
JWT_SECRET=

# origin ของหน้าเว็บ คั่นด้วยจุลภาค (ตอนขึ้น Vercel ให้เพิ่ม URL ของ Vercel)
ALLOWED_ORIGINS=http://localhost:5173

# Render ตั้งให้เอง ในเครื่องไม่ต้องใส่ก็ได้ (ค่าเริ่มต้น 8080)
PORT=8080
